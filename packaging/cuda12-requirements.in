# NVIDIA runtime libraries shipped in lib/ollaya/cuda_v12 (see docs/distribution.md), for drivers
# older than R580. Microsoft's ONNX Runtime 1.28.2 cuda12 build is built with CUDA 12.8; llama.cpp's
# ubuntu-cuda-12.8 build is the same CUDA minor. cuDNN is the same release as the CUDA 13 pack's.
# The hash lock is universal: it holds every platform's wheel hashes. package.sh takes the
# manylinux x86_64 wheels for linux-amd64 and the win_amd64 wheels for windows-amd64.
# Edit the pins here, then regenerate cuda12-requirements.txt (hashes) with:
#   uv pip compile packaging/cuda12-requirements.in --no-deps --universal --generate-hashes \
#     --no-annotate -o packaging/cuda12-requirements.txt
nvidia-cuda-runtime-cu12==12.8.90
nvidia-cublas-cu12==12.8.4.1
nvidia-cudnn-cu12==9.26.0.51
nvidia-cufft-cu12==11.3.3.83
nvidia-curand-cu12==10.3.9.90
nvidia-cuda-nvrtc-cu12==12.8.93
nvidia-nvjitlink-cu12==12.8.93
